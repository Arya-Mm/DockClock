{
  "info": {
    "name": "DockClock API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every DockClock endpoint, generated by scripts/postman.ts. PayPal sandbox only. Money-moving routes need x-ops-key. Run the Smoke folder first."
  },
  "item": [
    {
      "name": "Smoke (read-only, must be 2xx)",
      "item": [
        {
          "name": "GET /agents/verify",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/agents/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents",
                "verify"
              ]
            },
            "header": [
              {
                "key": "x-ops-key",
                "value": "{{opsKey}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
