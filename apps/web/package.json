{
  "name": "@dockclock/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "worker": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "worker:once": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/index.ts --once",
    "reconcile": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/reconcile.ts",
    "seed:reauth": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/seed-reauth-hold.ts",
    "demo:negotiate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/demo-negotiation.ts",
    "test:redteam": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test test/redteam.test.ts",
    "demo:driver": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/demo-driver.ts"
  },
  "dependencies": {
    "@dockclock/agents": "workspace:*",
    "@dockclock/core": "workspace:*",
    "@dockclock/db": "workspace:*",
    "@dockclock/paypal": "workspace:*",
    "ag-grid-community": "36.2.0",
    "ag-grid-enterprise": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
